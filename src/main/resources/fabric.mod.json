{
  "schemaVersion": 1,
  "id": "mcmusic",
  "version": "${version}",
  "name": "MC Music",
  "description": "YouTube Music in Minecraft: a client only mod with a modern, high resolution music client (search, playlists, favourites) that mixes the music into your Simple Voice Chat microphone stream, so everyone around you hears it. The server needs nothing but Simple Voice Chat.",
  "authors": [
    "chaostobimc"
  ],
  "contact": {
    "homepage": "https://github.com/chaostobimc/MinecraftMusic",
    "sources": "https://github.com/chaostobimc/MinecraftMusic",
    "issues": "https://github.com/chaostobimc/MinecraftMusic/issues"
  },
  "license": "MIT",
  "icon": "assets/mcmusic/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.chaostobimc.mcmusic.client.MCMusicClient"
    ],
    "voicechat": [
      "de.chaostobimc.mcmusic.voicechat.MCMusicVoicechatPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": ">=2.6.0",
    "voicechat_api": ">=${voicechat_api_version}"
  }
}
